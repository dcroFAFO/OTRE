# Public build configuration only. Never place provider secrets in VITE_* values.
VITE_BASE44_APP_ID=
VITE_BASE44_APP_BASE_URL=https://example.base44.app
VITE_BASE44_FUNCTIONS_VERSION=
VITE_PUBLIC_SITE_URL=https://ontherunelectrics.com.au
VITE_RELEASE_ID=local

# Browser-test target. Must be an isolated deployed staging site, never production.
PLAYWRIGHT_BASE_URL=https://example-staging.base44.app

# Optional same-origin endpoint for minimal client error events.
VITE_CLIENT_ERROR_ENDPOINT=
