{
  "name": "PaymentEffect",
  "type": "object",
  "properties": {
    "effect_key": { "type": "string", "unique": true, "maxLength": 240 },
    "payment_event_id": { "type": "string" },
    "effect_type": { "type": "string", "enum": ["invoice_projection", "job_projection", "audit_projection", "reward_projection"] },
    "subject_type": { "type": "string" },
    "subject_id": { "type": "string" },
    "status": { "type": "string", "enum": ["pending", "applying", "applied", "failed", "needs_reconciliation"], "default": "pending" },
    "attempt_count": { "type": "integer", "minimum": 0, "default": 0 },
    "applied_at": { "type": "string", "format": "date-time" },
    "last_attempt_at": { "type": "string", "format": "date-time" },
    "last_error_code": { "type": "string", "maxLength": 100 },
    "last_error_message": { "type": "string", "maxLength": 1000 }
  },
  "required": ["effect_key", "payment_event_id", "effect_type", "subject_type", "subject_id"],
  "rls": {
    "create": { "user_condition": { "role": "admin" } },
    "read": { "user_condition": { "role": "admin" } },
    "update": { "user_condition": { "role": "admin" } },
    "delete": { "user_condition": { "role": "admin" } }
  }
}
