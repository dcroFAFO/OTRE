{
  "name": "CustomerProfile",
  "type": "object",
  "properties": {
    "display_name": {
      "type": "string"
    },
    "name": {
      "type": "string"
    },
    "full_name": {
      "type": "string"
    },
    "email": {
      "type": "string"
    },
    "phone_e164": {
      "type": "string"
    },
    "display_photo": {
      "type": "string"
    },
    "oauth_provider": {
      "type": "string"
    },
    "scooter_make": {
      "type": "string"
    },
    "scooter_model": {
      "type": "string"
    },
    "scooter_make_model": {
      "type": "string"
    },
    "default_scooter_make_model": {
      "type": "string"
    },
    "auth_user_id": {
      "type": "string",
      "description": "DEPRECATED compatibility link. Never use for authorization; canonical ownership is Customer.user_id."
    },
    "customer_account_id": {
      "type": "string",
      "description": "Canonical Customer.id. This profile is presentation data only and never establishes ownership."
    },
    "email_verified": {
      "type": "boolean",
      "default": false
    },
    "phone_verified": {
      "type": "boolean",
      "default": false
    },
    "created_from_booking": {
      "type": "boolean",
      "default": false
    },
    "created_at": {
      "type": "string",
      "format": "date-time"
    },
    "updated_at": {
      "type": "string",
      "format": "date-time"
    },
    "description": {
      "type": "string",
      "maxLength": 1000
    }
  },
  "required": [
    "name",
    "email"
  ],
  "rls": {
    "create": {
      "user_condition": {
        "role": "admin"
      }
    },
    "read": {
      "user_condition": {
        "role": "admin"
      }
    },
    "update": {
      "user_condition": {
        "role": "admin"
      }
    },
    "delete": {
      "user_condition": {
        "role": "admin"
      }
    }
  }
}
