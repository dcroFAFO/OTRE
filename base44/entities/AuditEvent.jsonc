{
  "name": "AuditEvent",
  "type": "object",
  "properties": {
    "event_type": {
      "type": "string"
    },
    "job_id": {
      "type": "string"
    },
    "customer_id": {
      "type": "string"
    },
    "customer_account_id": {
      "type": "string",
      "description": "Canonical Customer.id when the event relates to a customer account."
    },
    "request_id": {
      "type": "string",
      "description": "Request or operation correlation id."
    },
    "outcome": {
      "type": "string",
      "enum": [
        "allowed",
        "denied",
        "succeeded",
        "failed"
      ]
    },
    "actor_id": {
      "type": "string"
    },
    "actor_name": {
      "type": "string"
    },
    "actor_role": {
      "type": "string"
    },
    "previous_value": {
      "type": "string"
    },
    "new_value": {
      "type": "string"
    },
    "summary": {
      "type": "string",
      "description": "Human-readable event summary"
    },
    "visibility": {
      "type": "string",
      "enum": [
        "internal",
        "customer",
        "system"
      ],
      "default": "internal"
    },
    "metadata": {
      "type": "object",
      "description": "Extensible metadata",
      "additionalProperties": true
    }
  },
  "required": [
    "event_type"
  ],
  "rls": {
    "create": {
      "user_condition": {
        "role": "admin"
      }
    },
    "read": {
      "user_condition": {
        "role": "admin"
      }
    },
    "update": {
      "user_condition": {
        "role": "admin"
      }
    },
    "delete": {
      "user_condition": {
        "role": "admin"
      }
    }
  }
}
