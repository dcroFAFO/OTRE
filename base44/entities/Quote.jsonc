{
  "name": "Quote",
  "type": "object",
  "properties": {
    "quote_id": {
      "type": "string",
      "description": "RETIRED \u2014 historical quote identifier."
    },
    "job_id": {
      "type": "string"
    },
    "customer_id": {
      "type": "string"
    },
    "template_id": {
      "type": "string"
    },
    "labour_hours": {
      "type": "number"
    },
    "labour_estimate": {
      "type": "number",
      "default": 0
    },
    "parts_estimate": {
      "type": "number",
      "default": 0
    },
    "diagnosis_notes": {
      "type": "string",
      "description": "RETIRED \u2014 diagnosis notes now live on Job.diagnosis_notes."
    },
    "recommended_repair": {
      "type": "string"
    },
    "total": {
      "type": "number",
      "default": 0
    },
    "currency": {
      "type": "string",
      "default": "AUD"
    },
    "status": {
      "type": "string",
      "description": "RETIRED \u2014 quote statuses are no longer used."
    },
    "sent_date": {
      "type": "string",
      "format": "date-time"
    },
    "approval_status": {
      "type": "string",
      "description": "RETIRED \u2014 quote approval no longer exists. Technicians build invoice line items directly."
    },
    "line_items": {
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "description": {
            "type": "string"
          },
          "qty": {
            "type": "number"
          },
          "unit_price": {
            "type": "number"
          },
          "internal_cost_price": {
            "type": "number"
          },
          "markup_percentage": {
            "type": "number",
            "default": 20
          },
          "customer_unit_price": {
            "type": "number"
          },
          "customer_line_total": {
            "type": "number"
          },
          "is_custom_misc_part": {
            "type": "boolean",
            "default": false
          },
          "staff_notes": {
            "type": "string"
          },
          "tax_rate": {
            "type": "number",
            "default": 0
          },
          "discount_amount": {
            "type": "number",
            "default": 0
          },
          "kind": {
            "type": "string"
          },
          "sku": {
            "type": "string"
          },
          "source_usage_id": {
            "type": "string"
          }
        }
      }
    },
    "ai_generated": {
      "type": "boolean",
      "default": false
    },
    "description": {
      "type": "string",
      "maxLength": 1000
    }
  },
  "required": [
    "job_id"
  ],
  "rls": {
    "create": false,
    "read": {
      "user_condition": {
        "role": "admin"
      }
    },
    "update": false,
    "delete": false
  }
}