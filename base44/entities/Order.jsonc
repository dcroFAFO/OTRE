{
  "name": "Order",
  "type": "object",
  "properties": {
    "job_id": {
      "type": "string"
    },
    "customer_id": {
      "type": "string"
    },
    "reference": {
      "type": "string",
      "description": "Human-readable order reference e.g. ORD-1042"
    },
    "checkout_attempt_id": {
      "type": "string",
      "description": "Client-generated idempotency key for a checkout attempt."
    },
    "stripe_checkout_session_id": {
      "type": "string"
    },
    "payment_intent_ref": {
      "type": "string"
    },
    "payment_status": {
      "type": "string",
      "enum": [
        "pending",
        "paid",
        "failed",
        "expired"
      ],
      "default": "pending"
    },
    "paid_date": {
      "type": "string",
      "format": "date-time"
    },
    "customer_name": {
      "type": "string"
    },
    "customer_email": {
      "type": "string"
    },
    "customer_phone": {
      "type": "string"
    },
    "shipping_address": {
      "type": "string"
    },
    "fulfilment_method": {
      "type": "string",
      "enum": [
        "delivery",
        "click_collect"
      ],
      "default": "delivery"
    },
    "pickup_address": {
      "type": "string"
    },
    "pickup_instructions": {
      "type": "string"
    },
    "items": {
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "product_id": {
            "type": "string"
          },
          "name": {
            "type": "string"
          },
          "sku": {
            "type": "string"
          },
          "qty": {
            "type": "number"
          },
          "price": {
            "type": "number"
          }
        }
      }
    },
    "subtotal": {
      "type": "number",
      "default": 0
    },
    "total": {
      "type": "number",
      "default": 0
    },
    "currency": {
      "type": "string",
      "default": "AUD"
    },
    "status": {
      "type": "string",
      "enum": [
        "pending_payment",
        "received",
        "forwarded_to_supplier",
        "processing",
        "shipped",
        "completed",
        "payment_failed",
        "cancelled"
      ],
      "default": "received"
    },
    "supplier": {
      "type": "string",
      "default": "eScootNow"
    },
    "notes": {
      "type": "string"
    },
    "archived_at": {
      "type": "string",
      "format": "date-time"
    },
    "archive_reason": {
      "type": "string",
      "maxLength": 500
    }
  },
  "required": [
    "customer_name"
  ],
  "rls": {
    "create": { "user_condition": { "role": "admin" } },
    "read": { "user_condition": { "role": "admin" } },
    "update": { "user_condition": { "role": "admin" } },
    "delete": {
      "user_condition": {
        "role": "admin"
      }
    }
  }
}
