{
  "name": "User",
  "type": "object",
  "properties": {
    "role": {
      "type": "string",
      "enum": [
        "admin",
        "customer"
      ],
      "default": "customer",
      "description": "Canonical platform-issued application role. Only the top-level authenticated user.role may be used for authorization. Legacy staff, employee and technician values are migrated to admin; all other values migrate to customer."
    },
    "phone": {
      "type": "string",
      "description": "Contact phone"
    },
    "phone_e164": {
      "type": "string",
      "description": "Verified mobile phone number in E.164 format."
    },
    "phone_verified": {
      "type": "boolean",
      "default": false,
      "description": "Whether the user's mobile phone number has been verified by SMS OTP."
    },
    "display_role_title": {
      "type": "string",
      "description": "Friendly job title e.g. Lead Technician"
    },
    "customer_id": {
      "type": "string",
      "description": "DEPRECATED compatibility field. Never use this mutable User field for authorization. Resolve the canonical Customer row by Customer.user_id instead."
    },
    "job_id": {
      "type": "string",
      "description": "DEPRECATED compatibility field. Never use this mutable User field for authorization or ownership."
    },
    "is_customer": {
      "type": "boolean",
      "default": true,
      "description": "DEPRECATED compatibility field. Never use this mutable User field for authorization; use the platform-issued top-level role."
    },
    "identity_version": {
      "type": "number",
      "default": 2,
      "description": "Identity model version last applied by the controlled identity migration."
    },
    "hasSeenCustomerPortalTutorial": {
      "type": "boolean",
      "default": false,
      "description": "Whether this customer has dismissed the portal getting-started checklist."
    }
  },
  "required": []
}
