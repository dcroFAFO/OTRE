{
  "name": "PhoneVerification",
  "type": "object",
  "properties": {
    "phone_e164": {
      "type": "string"
    },
    "email_hash": {
      "type": "string",
      "description": "Keyed SHA-256 rate-limit binding for the normalized signup email; plaintext email is not required for OTP verification."
    },
    "purpose": {
      "type": "string",
      "default": "signup"
    },
    "code_hash": {
      "type": "string"
    },
    "expires_at": {
      "type": "string",
      "format": "date-time"
    },
    "consumed_at": {
      "type": "string",
      "format": "date-time"
    },
    "attempts": {
      "type": "number",
      "default": 0
    },
    "consumed_by_user_id": {
      "type": "string"
    },
    "verified_at": {
      "type": "string",
      "format": "date-time"
    },
    "proof_id": {
      "type": "string"
    },
    "locked_at": {
      "type": "string",
      "format": "date-time"
    },
    "delivery_channel": {
      "type": "string",
      "enum": [
        "sms",
        "email"
      ]
    },
    "booking_id": {
      "type": "string"
    },
    "booking_created_at": {
      "type": "string",
      "format": "date-time"
    },
    "delivery_status": {
      "type": "string",
      "enum": [
        "sending",
        "sent",
        "failed",
        "ambiguous"
      ]
    },
    "sent_at": {
      "type": "string",
      "format": "date-time"
    },
    "delivery_failed_at": {
      "type": "string",
      "format": "date-time"
    },
    "provider_message_id": {
      "type": "string",
      "maxLength": 120
    },
    "request_ip_hash": {
      "type": "string"
    },
    "description": {
      "type": "string",
      "maxLength": 1000
    }
  },
  "required": [
    "phone_e164",
    "purpose",
    "code_hash",
    "expires_at"
  ],
  "rls": {
    "create": false,
    "read": false,
    "update": false,
    "delete": false
  }
}
