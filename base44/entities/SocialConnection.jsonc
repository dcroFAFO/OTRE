{
  "name": "SocialConnection",
  "type": "object",
  "properties": {
    "customer_id": {
      "type": "string",
      "description": "Stable customer identifier this connection belongs to."
    },
    "customer_account_id": {
      "type": "string",
      "description": "Linked Customer entity record id."
    },
    "auth_user_id": {
      "type": "string",
      "description": "Authenticated app user id who owns this connection."
    },
    "platform": {
      "type": "string",
      "enum": [
        "facebook",
        "instagram",
        "tiktok",
        "youtube",
        "x_twitter",
        "linkedin",
        "website"
      ]
    },
    "handle": {
      "type": "string",
      "description": "Display handle or username, e.g. @myhandle"
    },
    "profile_url": {
      "type": "string"
    },
    "status": {
      "type": "string",
      "enum": [
        "not_connected",
        "manual",
        "connected",
        "pending",
        "disabled",
        "unverified",
        "verified",
        "blocked"
      ],
      "default": "unverified",
      "description": "Verification is based only on a public allowlisted profile containing the generated code."
    },
    "external_account_id": {
      "type": "string",
      "description": "Reserved for future OAuth integrations."
    },
    "token_meta": {
      "type": "object",
      "additionalProperties": true,
      "description": "Placeholder for future OAuth token metadata (expiry, scopes). Never store real access tokens here."
    },
    "created_at": {
      "type": "string",
      "format": "date-time"
    },
    "updated_at": {
      "type": "string",
      "format": "date-time"
    },
    "verification_code": { "type": "string" },
    "verification_checked_at": { "type": "string", "format": "date-time" },
    "verification_attempt_count": { "type": "number", "default": 0 },
    "last_verification_attempt_at": { "type": "string", "format": "date-time" },
    "verification_window_started_at": { "type": "string", "format": "date-time" },
    "verification_result": {
      "type": "string",
      "enum": ["not_checked", "verified", "code_not_found", "blocked", "rate_limited"],
      "default": "not_checked"
    },
    "description": {
      "type": "string",
      "maxLength": 1000
    }
  },
  "required": [
    "platform"
  ],
  "rls": {
    "create": {
      "user_condition": {
        "role": "admin"
      }
    },
    "read": {
      "user_condition": {
        "role": "admin"
      }
    },
    "update": {
      "user_condition": {
        "role": "admin"
      }
    },
    "delete": {
      "user_condition": {
        "role": "admin"
      }
    }
  }
}
