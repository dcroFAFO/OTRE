{
  "name": "BlogSettings",
  "type": "object",
  "properties": {
    "user_id": {
      "type": "string",
      "description": "Staff user who last created the settings record. Provenance only. There is exactly ONE settings record for the whole blog \u2014 do not create per-user records."
    },
    "account_id": {
      "type": "string"
    },
    "blog_enabled": {
      "type": "boolean",
      "default": true
    },
    "blog_name": {
      "type": "string",
      "default": "Blog"
    },
    "blog_description": {
      "type": "string",
      "maxLength": 1000
    },
    "default_author_name": {
      "type": "string"
    },
    "default_author_bio": {
      "type": "string",
      "maxLength": 1000
    },
    "default_author_avatar_url": {
      "type": "string"
    },
    "default_blog_route": {
      "type": "string",
      "default": "/blog"
    },
    "posts_per_page": {
      "type": "number",
      "default": 9
    },
    "show_author_box": {
      "type": "boolean",
      "default": true
    },
    "show_related_posts": {
      "type": "boolean",
      "default": true
    },
    "enable_ai_generation": {
      "type": "boolean",
      "default": true
    },
    "enable_scheduled_publishing": {
      "type": "boolean",
      "default": true
    },
    "created_at": {
      "type": "string",
      "format": "date-time"
    },
    "updated_at": {
      "type": "string",
      "format": "date-time"
    }
  },
  "required": [
    "user_id"
  ],
  "rls": {
    "create": {
      "$or": [
        {
          "user_condition": {
            "role": "admin"
          }
        },
        {
          "user_condition": {
            "role": "employee"
          }
        },
        {
          "user_condition": {
            "role": "technician"
          }
        }
      ]
    },
    "read": {
      "$or": [
        {
          "user_condition": {
            "role": "admin"
          }
        },
        {
          "user_condition": {
            "role": "employee"
          }
        },
        {
          "user_condition": {
            "role": "technician"
          }
        }
      ]
    },
    "update": {
      "$or": [
        {
          "user_condition": {
            "role": "admin"
          }
        },
        {
          "user_condition": {
            "role": "employee"
          }
        },
        {
          "user_condition": {
            "role": "technician"
          }
        }
      ]
    },
    "delete": {
      "user_condition": {
        "role": "admin"
      }
    }
  }
}