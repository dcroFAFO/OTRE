{
  "name": "PaymentProviderConfig",
  "type": "object",
  "properties": {
    "provider_key": {
      "type": "string"
    },
    "display_name": {
      "type": "string"
    },
    "mode": {
      "type": "string",
      "enum": ["manual_only", "disabled", "legacy_read_only"],
      "default": "manual_only"
    },
    "settings": {
      "type": "object",
      "additionalProperties": true
    },
    "active": {
      "type": "boolean",
      "default": false
    },
    "description": {
      "type": "string",
      "maxLength": 1000
    }
  },
  "required": [
    "provider_key",
    "display_name"
  ],
  "rls": {
    "create": { "user_condition": { "role": "admin" } },
    "read": { "user_condition": { "role": "admin" } },
    "update": { "user_condition": { "role": "admin" } },
    "delete": {
      "user_condition": {
        "role": "admin"
      }
    }
  }
}
