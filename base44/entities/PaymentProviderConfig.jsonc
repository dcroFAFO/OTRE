{
  "name": "PaymentProviderConfig",
  "type": "object",
  "properties": {
    "provider_key": {
      "type": "string"
    },
    "display_name": {
      "type": "string"
    },
    "mode": {
      "type": "string",
      "default": "not_configured"
    },
    "settings": {
      "type": "object",
      "additionalProperties": true
    },
    "active": {
      "type": "boolean",
      "default": false
    },
    "description": {
      "type": "string",
      "maxLength": 1000
    }
  },
  "required": [
    "provider_key",
    "display_name"
  ],
  "rls": {
    "create": {
      "$or": [
        {
          "user_condition": {
            "role": "admin"
          }
        },
        {
          "user_condition": {
            "role": "technician"
          }
        }
      ]
    },
    "read": {
      "$or": [
        {
          "user_condition": {
            "role": "admin"
          }
        },
        {
          "user_condition": {
            "role": "technician"
          }
        }
      ]
    },
    "update": {
      "$or": [
        {
          "user_condition": {
            "role": "admin"
          }
        },
        {
          "user_condition": {
            "role": "technician"
          }
        }
      ]
    },
    "delete": {
      "user_condition": {
        "role": "admin"
      }
    }
  }
}