{
  "name": "Customer",
  "type": "object",
  "properties": {
    "customer_id": {
      "type": "string",
      "description": "Shared customer account identifier used to link users, jobs, quotes, invoices, attachments, and notes."
    },
    "job_id": {
      "type": "string",
      "description": "Comma-separated list of Job entity IDs associated with this customer."
    },
    "invoice_id": {
      "type": "string",
      "description": "Comma-separated list of Invoice entity IDs associated with this customer."
    },
    "name": {
      "type": "string",
      "description": "Public booking compatible customer name"
    },
    "full_name": {
      "type": "string"
    },
    "email": {
      "type": "string"
    },
    "phone": {
      "type": "string",
      "description": "Primary phone number stored in E.164 format for SMS workflows."
    },
    "phone_e164": {
      "type": "string",
      "description": "Normalized E.164 phone number used by Twilio."
    },
    "phone_display": {
      "type": "string",
      "description": "User-friendly local phone number as entered/displayed."
    },
    "phone_country_code": {
      "type": "string",
      "default": "+61",
      "description": "Selected country calling code for phone input."
    },
    "user_id": {
      "type": "string",
      "description": "Canonical authenticated User.id for this customer account. One User may own at most one Customer and ownership is never inferred from email or phone.",
      "unique": true
    },
    "identity_version": {
      "type": "number",
      "default": 2,
      "description": "Canonical identity model version."
    },
    "identity_linked_at": {
      "type": "string",
      "format": "date-time",
      "description": "When user_id was established by an authenticated or verified claim flow."
    },
    "identity_link_source": {
      "type": "string",
      "enum": [
        "authenticated_signup",
        "verified_guest_claim",
        "admin_migration"
      ],
      "description": "Auditable source of the canonical user_id link."
    },
    "createdAt": {
      "type": "string",
      "format": "date-time",
      "description": "Public booking compatible creation timestamp"
    },
    "status": {
      "type": "string",
      "enum": [
        "active",
        "pending",
        "in_review",
        "onboarding",
        "needs_follow_up",
        "inactive",
        "suspended",
        "closed"
      ],
      "default": "active",
      "description": "Staff-managed account status. Customers can never set this themselves."
    },
    "tags": {
      "type": "array",
      "items": {
        "type": "string"
      },
      "description": "Staff-managed segments e.g. vip, active_client, past_client, high_priority, needs_attention"
    },
    "last_activity_date": {
      "type": "string",
      "format": "date-time",
      "description": "Most recent known activity (job, invoice, note, status change)"
    },
    "notes": {
      "type": "string",
      "description": "Customer notes"
    },
    "referral_code": {
      "type": "string",
      "description": "This customer's own referral code they can share with friends."
    },
    "referred_by_customer_id": {
      "type": "string",
      "description": "Customer.id of the customer who referred this customer, if any."
    },
    "referral_status": {
      "type": "string",
      "enum": [
        "none",
        "pending",
        "completed"
      ],
      "default": "none",
      "description": "Placeholder referral reward status, tracked manually by staff for now."
    },
    "referral_eligible": {
      "type": "boolean",
      "default": false,
      "description": "Placeholder flag for staff to mark a customer as eligible for their referral reward."
    },
    "referral_notes": {
      "type": "string",
      "description": "Staff-only referral notes. Never shown to customers."
    },
    "referral_claimed_at": {
      "type": "string",
      "format": "date-time",
      "description": "When this customer claimed a referral code during registration."
    },
    "referral_source_code": {
      "type": "string",
      "description": "Referral code captured for this customer at registration."
    },
    "first_paid_invoice_id": {
      "type": "string",
      "description": "First settled invoice used for one-time referral issuance."
    },
    "first_paid_invoice_at": {
      "type": "string",
      "format": "date-time"
    },
    "loyalty_paid_repair_count": {
      "type": "number",
      "default": 0
    },
    "loyalty_reward_milestone": {
      "type": "number",
      "default": 0,
      "description": "Highest five-repair milestone already issued."
    }
  },
  "required": [
    "full_name"
  ],
  "rls": {
    "create": {
      "user_condition": {
        "role": "admin"
      }
    },
    "read": {
      "user_condition": {
        "role": "admin"
      }
    },
    "update": {
      "user_condition": {
        "role": "admin"
      }
    },
    "delete": {
      "user_condition": {
        "role": "admin"
      }
    }
  }
}
