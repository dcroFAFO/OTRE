{
  "name": "Job",
  "type": "object",
  "properties": {
    "job_id": {
      "type": "string",
      "description": "DEPRECATED \u2014 never read or write. Only ever held a copy of the record id. Use `id` for lookups and `reference` for display."
    },
    "tracking_token": {
      "type": "string",
      "description": "DEPRECATED \u2014 no longer written. Public access tokens are stored as SHA-256 hashes on PublicJobAccess."
    },
    "guest_access_token": {
      "type": "string",
      "description": "DEPRECATED \u2014 no longer written. See PublicJobAccess.tokenHash."
    },
    "customer_profile_id": {
      "type": "string",
      "description": "DEPRECATED presentation link. Never use for authorization."
    },
    "customer_user_id": {
      "type": "string",
      "description": "Derived compatibility snapshot of Customer.user_id. Never authorize from this field alone."
    },
    "quote_id": {
      "type": "string",
      "description": "RETIRED \u2014 quote approval no longer exists. Technicians build invoice line items directly."
    },
    "invoice_id": {
      "type": "string"
    },
    "reference": {
      "type": "string",
      "description": "The single human-facing job identifier, e.g. OTR-48213. Minted by shared/jobReference.ts."
    },
    "customerId": {
      "type": "string",
      "description": "DEPRECATED compatibility identifier. Never use for authorization."
    },
    "customer_id": {
      "type": "string",
      "description": "DEPRECATED compatibility identifier. Never use for authorization."
    },
    "customer_account_id": {
      "type": "string",
      "description": "Canonical Customer.id owner. Empty means the job is unclaimed."
    },
    "claimed_by_customer": {
      "type": "boolean",
      "default": false
    },
    "claim_status": {
      "type": "string",
      "enum": [
        "unclaimed",
        "claimed"
      ],
      "default": "unclaimed"
    },
    "contact_verification_id": {
      "type": "string",
      "description": "ContactVerificationChallenge.id used to create an unclaimed guest booking."
    },
    "verified_contact_channel": {
      "type": "string",
      "enum": [
        "email",
        "sms"
      ]
    },
    "verified_contact_hash": {
      "type": "string",
      "description": "SHA-256 hash binding the verified email and phone snapshot; no authority by itself."
    },
    "claimed_at": {
      "type": "string",
      "format": "date-time"
    },
    "completed_at": {
      "type": "string",
      "format": "date-time",
      "description": "Canonical completion timestamp used to expire public tracking grants after 30 days."
    },
    "customer_name": {
      "type": "string"
    },
    "customer_email": {
      "type": "string"
    },
    "customer_phone": {
      "type": "string"
    },
    "customer_phone_e164": {
      "type": "string"
    },
    "customer_phone_display": {
      "type": "string"
    },
    "asset_id": {
      "type": "string"
    },
    "asset_label": {
      "type": "string"
    },
    "scooter_make_model": {
      "type": "string"
    },
    "scooterDetails": {
      "type": "string"
    },
    "scooter_details": {
      "type": "string"
    },
    "service_item_id": {
      "type": "string"
    },
    "service_category_key": {
      "type": "string"
    },
    "service_type": {
      "type": "string",
      "enum": [
        "general_repair",
        "puncture_tyres",
        "brakes",
        "battery",
        "controller_electronics",
        "display_dashboard",
        "throttle",
        "wiring",
        "water_damage",
        "service_maintenance",
        "diagnostic",
        "warranty",
        "custom_work",
        "other"
      ],
      "default": "general_repair"
    },
    "priority": {
      "type": "string",
      "enum": [
        "low",
        "medium",
        "high",
        "urgent"
      ],
      "default": "medium"
    },
    "issueDescription": {
      "type": "string"
    },
    "issue_description": {
      "type": "string"
    },
    "issue_summary": {
      "type": "string"
    },
    "rideable_status": {
      "type": "string"
    },
    "job_status": {
      "type": "string",
      "description": "DEPRECATED \u2014 never read or write. Dead duplicate of `status`, permanently stale. Use `status`."
    },
    "private_notes": {
      "type": "string"
    },
    "diagnosis_notes": {
      "type": "string",
      "description": "Technician diagnosis findings recorded during the repair. Replaces the retired Quote.diagnosis_notes."
    },
    "bookingRequestSmsSentAt": {
      "type": "string",
      "format": "date-time",
      "description": "Set once the booking request confirmation SMS has been sent. Prevents duplicate sends."
    },
    "bookingRequestEmailSentAt": {
      "type": "string",
      "format": "date-time",
      "description": "Set once the booking request confirmation email has been sent. Prevents duplicate sends."
    },
    "bookingRequestNotificationVersion": {
      "type": "string",
      "description": "Notification flow version used for the booking request confirmation, e.g. booking_request_received_v1."
    },
    "booking_submission": {
      "type": "object",
      "additionalProperties": true,
      "properties": {
        "customerName": {
          "type": "string"
        },
        "customerEmail": {
          "type": "string"
        },
        "customerPhone": {
          "type": "string"
        },
        "customerPhoneE164": {
          "type": "string"
        },
        "phoneCountryCode": {
          "type": "string"
        },
        "scooterIssueSummary": {
          "type": "string"
        },
        "scooterMakeModel": {
          "type": "string"
        },
        "rideableStatus": {
          "type": "string"
        },
        "urgencyOrSafetyNotes": {
          "type": "string"
        },
        "suspectedServiceCategory": {
          "type": "string"
        },
        "scooterMake": {
          "type": "string"
        },
        "scooterBrand": {
          "type": "string"
        },
        "scooterModel": {
          "type": "string"
        },
        "assetLabel": {
          "type": "string"
        },
        "issueOrService": {
          "type": "string"
        },
        "issueDescription": {
          "type": "string"
        },
        "serviceRequested": {
          "type": "string"
        },
        "serviceType": {
          "type": "string"
        },
        "preferredDate": {
          "type": "string",
          "format": "date"
        },
        "preferredTimeWindow": {
          "type": "string"
        },
        "isRideable": {
          "type": "boolean"
        },
        "asap": {
          "type": "boolean"
        },
        "photos": {
          "type": "array",
          "items": {
            "type": "string"
          }
        },
        "files": {
          "type": "array",
          "items": {
            "type": "string"
          }
        },
        "submittedAt": {
          "type": "string",
          "format": "date-time"
        }
      }
    },
    "intake": {
      "type": "object",
      "additionalProperties": true,
      "properties": {
        "customerName": {
          "type": "string"
        },
        "customerEmail": {
          "type": "string"
        },
        "customerPhone": {
          "type": "string"
        },
        "customerPhoneE164": {
          "type": "string"
        },
        "scooterMake": {
          "type": "string"
        },
        "scooterModel": {
          "type": "string"
        },
        "issueOrService": {
          "type": "string"
        },
        "service_type": {
          "type": "string"
        },
        "date": {
          "type": "string",
          "format": "date"
        },
        "isRideable": {
          "type": "boolean"
        },
        "booking_files": {
          "type": "array",
          "items": {
            "type": "string"
          }
        },
        "make": {
          "type": "string"
        },
        "model": {
          "type": "string"
        },
        "serial_number": {
          "type": "string"
        },
        "battery_condition": {
          "type": "string",
          "enum": [
            "good",
            "fair",
            "poor",
            "faulty",
            "unknown"
          ]
        },
        "battery_voltage": {
          "type": "string"
        },
        "odometer_km": {
          "type": "number"
        },
        "physical_condition": {
          "type": "string"
        },
        "accessories_received": {
          "type": "string"
        },
        "powers_on": {
          "type": "boolean"
        },
        "initial_issue_notes": {
          "type": "string"
        },
        "intake_by_name": {
          "type": "string"
        },
        "intake_date": {
          "type": "string",
          "format": "date-time"
        }
      }
    },
    "source": {
      "type": "string",
      "enum": [
        "public_booking",
        "staff_created"
      ],
      "default": "staff_created"
    },
    "business_slug": {
      "type": "string"
    },
    "job_type": {
      "type": "string",
      "default": "service"
    },
    "status": {
      "type": "string",
      "enum": [
        "requested",
        "scheduled",
        "repair_in_progress",
        "ready_for_pickup",
        "invoice_outstanding",
        "completed",
        "waiting_on_parts",
        "on_hold",
        "cancelled"
      ],
      "default": "requested",
      "description": "Canonical lifecycle. Main path: requested \u2192 scheduled \u2192 repair_in_progress \u2192 ready_for_pickup \u2192 invoice_outstanding \u2192 completed. waiting_on_parts, on_hold and cancelled are side states reachable from anywhere. Quote statuses are retired."
    },
    "waiting_reason": {
      "type": "string"
    },
    "scheduled_date": {
      "type": "string",
      "format": "date"
    },
    "preferred_time_window": {
      "type": "string"
    },
    "rideable": {
      "type": "boolean",
      "default": true
    },
    "payment_status": {
      "type": "string",
      "default": "unpaid"
    },
    "quote_status": {
      "type": "string",
      "description": "RETIRED \u2014 quote approval no longer exists. Never read or write."
    },
    "ready_for_pickup": {
      "type": "boolean",
      "default": false
    },
    "archived_at": {
      "type": "string",
      "format": "date-time",
      "description": "Administrative archive timestamp. Archived jobs remain available for audit and relationship history."
    },
    "archived_by_user_id": {
      "type": "string"
    },
    "archive_reason": {
      "type": "string",
      "maxLength": 500
    },
    "createdAt": {
      "type": "string",
      "format": "date-time"
    },
    "created_at": {
      "type": "string",
      "format": "date-time"
    },
    "updatedAt": {
      "type": "string",
      "format": "date-time"
    },
    "checklist": {
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "label": {
            "type": "string"
          },
          "done": {
            "type": "boolean",
            "default": false
          }
        }
      }
    },
    "parts_required": {
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "name": {
            "type": "string"
          },
          "qty": {
            "type": "number"
          },
          "status": {
            "type": "string"
          }
        }
      }
    },
    "description": {
      "type": "string",
      "maxLength": 1000
    }
  },
  "required": [
    "customer_name"
  ],
  "rls": {
    "create": {
      "user_condition": {
        "role": "admin"
      }
    },
    "read": {
      "user_condition": {
        "role": "admin"
      }
    },
    "update": {
      "user_condition": {
        "role": "admin"
      }
    },
    "delete": {
      "user_condition": {
        "role": "admin"
      }
    }
  }
}
