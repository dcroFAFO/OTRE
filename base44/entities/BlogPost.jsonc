{
  "name": "BlogPost",
  "type": "object",
  "properties": {
    "user_id": {
      "type": "string",
      "description": "Staff user who created the post. Retained for provenance and author attribution only \u2014 it no longer restricts access."
    },
    "account_id": {
      "type": "string"
    },
    "title": {
      "type": "string"
    },
    "slug": {
      "type": "string"
    },
    "excerpt": {
      "type": "string",
      "maxLength": 1000
    },
    "content_markdown": {
      "type": "string"
    },
    "content_html": {
      "type": "string"
    },
    "status": {
      "type": "string",
      "enum": [
        "draft",
        "scheduled",
        "published",
        "archived"
      ],
      "default": "draft"
    },
    "target_keyword": {
      "type": "string"
    },
    "category_id": {
      "type": "string"
    },
    "tag_ids": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "author_name": {
      "type": "string"
    },
    "author_bio": {
      "type": "string",
      "maxLength": 1000
    },
    "author_avatar_url": {
      "type": "string"
    },
    "featured_image_url": {
      "type": "string"
    },
    "featured_image_alt": {
      "type": "string"
    },
    "meta_title": {
      "type": "string"
    },
    "meta_description": {
      "type": "string",
      "maxLength": 320
    },
    "canonical_url": {
      "type": "string"
    },
    "reading_time_minutes": {
      "type": "number",
      "default": 1
    },
    "word_count": {
      "type": "number",
      "default": 0
    },
    "generated_by": {
      "type": "string",
      "enum": [
        "manual",
        "ai",
        "autopilot"
      ],
      "default": "manual",
      "description": "How this post was created. Set by generateBlogPost and the autopilot workflow."
    },
    "scheduled_at": {
      "type": "string",
      "format": "date-time"
    },
    "published_at": {
      "type": "string",
      "format": "date-time"
    },
    "created_at": {
      "type": "string",
      "format": "date-time"
    },
    "updated_at": {
      "type": "string",
      "format": "date-time"
    }
  },
  "required": [
    "user_id",
    "title",
    "slug"
  ],
  "rls": {
    "create": {
      "$or": [
        {
          "user_condition": {
            "role": "admin"
          }
        },
        {
          "user_condition": {
            "role": "employee"
          }
        },
        {
          "user_condition": {
            "role": "technician"
          }
        }
      ]
    },
    "read": {
      "$or": [
        {
          "user_condition": {
            "role": "admin"
          }
        },
        {
          "user_condition": {
            "role": "employee"
          }
        },
        {
          "user_condition": {
            "role": "technician"
          }
        }
      ]
    },
    "update": {
      "$or": [
        {
          "user_condition": {
            "role": "admin"
          }
        },
        {
          "user_condition": {
            "role": "employee"
          }
        },
        {
          "user_condition": {
            "role": "technician"
          }
        }
      ]
    },
    "delete": {
      "user_condition": {
        "role": "admin"
      }
    }
  }
}