{
  "name": "BlogPost",
  "type": "object",
  "properties": {
    "user_id": {
      "type": "string",
      "description": "Staff user who created the post. Retained for authorship history only \u2014 it no longer controls visibility."
    },
    "account_id": {
      "type": "string"
    },
    "title": {
      "type": "string"
    },
    "slug": {
      "type": "string"
    },
    "excerpt": {
      "type": "string",
      "maxLength": 1000
    },
    "content_markdown": {
      "type": "string"
    },
    "content_html": {
      "type": "string"
    },
    "status": {
      "type": "string",
      "enum": [
        "draft",
        "scheduled",
        "published",
        "archived"
      ],
      "default": "draft"
    },
    "target_keyword": {
      "type": "string"
    },
    "category_id": {
      "type": "string"
    },
    "tag_ids": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "author_name": {
      "type": "string"
    },
    "author_bio": {
      "type": "string",
      "maxLength": 1000
    },
    "author_avatar_url": {
      "type": "string"
    },
    "featured_image_url": {
      "type": "string"
    },
    "featured_image_alt": {
      "type": "string"
    },
    "meta_title": {
      "type": "string"
    },
    "meta_description": {
      "type": "string",
      "maxLength": 320
    },
    "canonical_url": {
      "type": "string"
    },
    "reading_time_minutes": {
      "type": "number",
      "default": 1
    },
    "word_count": {
      "type": "number",
      "default": 0
    },
    "generated_by": {
      "type": "string",
      "enum": [
        "manual",
        "ai",
        "autopilot"
      ],
      "default": "manual",
      "description": "How this post was created. Existing posts default to manual."
    },
    "approval_status": {
      "type": "string",
      "enum": [
        "not_required",
        "pending",
        "approved",
        "rejected"
      ],
      "default": "not_required",
      "description": "Admin approval state. Defaults to not_required so existing and manually created posts keep their current publishing behaviour."
    },
    "approved_by_id": {
      "type": "string"
    },
    "approved_at": {
      "type": "string",
      "format": "date-time"
    },
    "seo_score": {
      "type": "number",
      "description": "Most recent on-page SEO score out of 100."
    },
    "seo_findings": {
      "type": "object",
      "additionalProperties": true,
      "description": "Structured findings from the last SEO analysis."
    },
    "source_keyword_id": {
      "type": "string",
      "description": "BlogKeyword record this post was generated from, when applicable."
    },
    "last_refreshed_at": {
      "type": "string",
      "format": "date-time"
    },
    "refresh_recommended": {
      "type": "boolean",
      "default": false
    },
    "scheduled_at": {
      "type": "string",
      "format": "date-time"
    },
    "published_at": {
      "type": "string",
      "format": "date-time"
    },
    "created_at": {
      "type": "string",
      "format": "date-time"
    },
    "updated_at": {
      "type": "string",
      "format": "date-time"
    }
  },
  "required": [
    "user_id",
    "title",
    "slug"
  ],
  "rls": {
    "create": {
      "$or": [
        {
          "user_condition": {
            "role": "admin"
          }
        },
        {
          "user_condition": {
            "role": "admin"
          }
        },
        {
          "user_condition": {
            "role": "admin"
          }
        }
      ]
    },
    "read": {
      "$or": [
        {
          "user_condition": {
            "role": "admin"
          }
        },
        {
          "user_condition": {
            "role": "admin"
          }
        },
        {
          "user_condition": {
            "role": "admin"
          }
        }
      ]
    },
    "update": {
      "$or": [
        {
          "user_condition": {
            "role": "admin"
          }
        },
        {
          "user_condition": {
            "role": "admin"
          }
        },
        {
          "user_condition": {
            "role": "admin"
          }
        }
      ]
    },
    "delete": {
      "user_condition": {
        "role": "admin"
      }
    }
  }
}
